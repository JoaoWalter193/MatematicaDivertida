<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnAritimeticaBasica"
        android:layout_width="249dp"
        android:layout_height="74dp"
        android:layout_marginTop="336dp"
        android:onClick="irAritimetica"
        android:text="Aritimética Básica"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnMaiorNumero"
        android:layout_width="249dp"
        android:layout_height="74dp"
        android:layout_marginTop="100dp"
        android:onClick="irMaior"
        android:text="Maior número"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAritimeticaBasica"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btnContagem"
        android:layout_width="249dp"
        android:layout_height="74dp"
        android:layout_marginTop="156dp"
        android:onClick="irContagem"
        android:text="Contagem"
        app:layout_constraintBottom_toTopOf="@+id/btnAritimeticaBasica"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>